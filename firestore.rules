rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
